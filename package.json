{
  "name": "quran-memoriser",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Offline-first Madani Mushaf reader with verse selection",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "data:fetch": "node scripts/fetch-sources.mjs",
    "data:build": "node scripts/build-data.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@playwright/test": "^1.65.1",
    "@serwist/vite": "^9.5.13",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^26.6.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@serwist/precaching": "^9.5.13",
    "@serwist/sw": "^9.5.13",
    "@serwist/window": "^9.5.13",
    "@tanstack/svelte-virtual": "^3.13.52",
    "arabic-text-normalizer": "^1.4.0",
    "idb": "^8.0.4",
    "lru-cache": "^11.5.3",
    "p-limit": "^7.3.3",
    "serwist": "^9.5.13",
    "zod": "^4.6.7"
  }
}
